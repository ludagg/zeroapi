generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH (Better Auth) ============

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  emailVerified    Boolean  @default(false)
  name             String?
  avatar           String?
  image            String?
  role             UserRole @default(USER)
  plan             Plan     @default(FREE)
  generationsUsed  Int      @default(0)
  generationsLimit Int      @default(3)
  notifyOnReady    Boolean  @default(true)
  notifyOnFailed   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jobs        Job[]
  deployments Deployment[]
  databases   Database[]
  teamMembers TeamMember[]
  sessions    Session[]
  accounts    Account[]
  conversations Conversation[]
  apiKeys     PersonalApiKey[]
  templates   Template[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============ JOBS ============

model Job {
  id            String    @id @default(cuid())
  userId        String
  name          String
  description   String
  status        JobStatus @default(PENDING)
  // PUBLIC = the job's spec is published as a community template in the marketplace.
  visibility    TemplateVisibility @default(PRIVATE)
  spec          Json?
  zipUrl        String?
  errorMessage  String?
  endpoints     Int?
  testsTotal    Int?
  testsPassed   Int?
  securityScore String?
  estimatedTime Int?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployment   Deployment?
  database     Database?
  agentLogs    AgentLog[]
  envVariables EnvVariable[]
  conversations Conversation[]
  template     Template?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model EnvVariable {
  id        String   @id @default(cuid())
  jobId     String
  key       String
  value     String
  managed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
  @@index([jobId])
}

model AgentLog {
  id        String   @id @default(cuid())
  jobId     String
  agent     String
  status    String
  message   String?
  duration  Int?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Deployment {
  id        String           @id @default(cuid())
  userId    String
  jobId     String           @unique
  platform  DeployPlatform
  url       String?
  status    DeploymentStatus @default(PENDING)
  // Coolify identifiers, persisted so the status endpoint can poll the real
  // server-side state after the (asynchronous) build is triggered. Without
  // these we'd have nothing to ask Coolify about post-trigger.
  coolifyAppUuid        String?
  coolifyDeploymentUuid String?
  // Step-by-step deployment journal, surfaced to the user on the job page.
  // Array of { ts: number, level: "info" | "error", message: string }.
  logs      Json             @default("[]")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  title     String   @default("Nouvelle conversation")
  messages  Json     @default("[]")
  spec      Json?
  // Ordered snapshots of the spec for undo/redo + version history.
  specHistory Json   @default("[]")
  // Index of the active snapshot in specHistory (-1 = none yet).
  specVersion Int    @default(-1)
  // Public read-only share token (null = not shared).
  shareSlug String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([jobId])
}

// ============ MARKETPLACE TEMPLATES ============

model Template {
  id          String             @id @default(cuid())
  title       String
  description String
  category    String
  emoji       String             @default("✦")
  spec        Json
  // null author = official ZeroAPI template.
  authorId    String?
  // The community job this template was published from (null for official ones).
  // Lets a re-save update the same template instead of creating duplicates.
  jobId       String?            @unique
  isOfficial  Boolean            @default(false)
  visibility  TemplateVisibility @default(PRIVATE)
  usageCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  job    Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  // Marketplace listing: public templates, most-used first.
  @@index([visibility, isOfficial, usageCount(sort: Desc)])
  @@index([authorId])
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  email     String
  role      String   @default("member")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Database {
  id        String   @id @default(cuid())
  userId    String
  jobId     String   @unique
  name      String
  provider  String   @default("postgresql")
  sizeBytes Int?
  tables    Int?
  status    String   @default("online")
  managed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model PersonalApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIProviderConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  apiKey    String
  model     String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LLMRoutingConfig {
  id        String   @id @default(cuid())
  plan      Plan
  task      String
  provider  String
  updatedAt DateTime @updatedAt

  @@unique([plan, task])
}

// ============ PLATFORM SETTINGS ============

/// Generic key/value store for platform-wide settings configurable from the
/// admin UI (e.g. the Telegram alert bot). Secret values (bot token) are
/// stored encrypted via lib/crypto-secrets.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

// ============ ACTIVITY & SECURITY LOG ============

/// Unified audit/activity trail. Captures both product activity
/// (signups, jobs, deployments, admin actions) and security events
/// (failed logins, rate-limit breaches, suspicious path scans).
/// userId is intentionally loose (no FK) so anonymous attacks can be logged.
model ActivityLog {
  id         String           @id @default(cuid())
  kind       ActivityKind     @default(ACTIVITY)
  type       String
  severity   ActivitySeverity @default(INFO)
  message    String?
  userId     String?
  actorEmail String?
  ip         String?
  userAgent  String?
  path       String?
  method     String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([type])
  @@index([userId])
  @@map("activity_log")
}

enum ActivityKind {
  ACTIVITY
  SECURITY
}

enum ActivitySeverity {
  INFO
  WARNING
  CRITICAL
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum JobStatus {
  DRAFT
  PENDING
  RUNNING
  READY
  DEPLOYED
  FAILED
}

enum DeployPlatform {
  RAILWAY
  RENDER
  VERCEL
  FLYIO
  ZEROAPI_CLOUD
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  ONLINE
  FAILED
}

enum TemplateVisibility {
  PUBLIC
  PRIVATE
}
